# Copy this file to .env at the repository root.
# The backend reads backend/.env first, then this root .env.
# Never commit .env. Values below are local defaults only.

NODE_ENV=development
PORT=4000

# Host URLs for `npm run dev` in backend/. Inside Docker Compose the backend
# service overrides these to use the postgres and redis hostnames.
DATABASE_URL=postgresql://auction:auction@localhost:5432/auction
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:3000

# Docker Compose Postgres container. Keep these aligned with DATABASE_URL.
POSTGRES_USER=auction
POSTGRES_PASSWORD=auction
POSTGRES_DB=auction

# Copy the two lines below into frontend/.env.local
# NEXT_PUBLIC_API_URL=http://localhost:4000
# NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
